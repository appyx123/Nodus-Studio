{
  "identifier": "main-components",
  "description": "Read validated built-in components, edit session circuit topology, compile firmware, and run simulation in the local main window.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-list-components",
    "allow-get-circuit",
    "allow-edit-circuit",
    "allow-get-simulation-frame",
    "allow-control-simulation",
    "allow-set-control-value",
    "allow-compile-sketch",
    "allow-cancel-compilation",
    "allow-serial-io",
    "allow-get-mqtt-config",
    "allow-set-mqtt-config",
    "allow-get-mqtt-status",
    "allow-publish-mqtt-message",
    "allow-save-project",
    "allow-load-project",
    "allow-export-project-json",
    "allow-import-project-json"
  ]
}
